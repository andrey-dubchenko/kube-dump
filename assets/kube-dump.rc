// Windows resources linked into kube-dump.exe: the icon and the version information.
// Regenerate the object file (from this directory):
//   windres --use-temp-file -O coff -i kube-dump.rc -o ../cmd/kube-dump/resource_windows_amd64.syso

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "JVM thread and heap dumps from Kubernetes pods"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "kube-dump"
      VALUE "OriginalFilename", "kube-dump.exe"
      VALUE "ProductName", "kube-dump"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
